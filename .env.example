# Copie estas variáveis para o painel da Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo nem no código.

# Anthropic (obrigatório) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo usado (padrão: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# Supabase (obrigatório) — Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=

# Notificações push (obrigatório para lembretes) — gere em https://SEU-APP.vercel.app/api/gerar-chaves
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
CRON_SECRET=

# Opcional: quantos minutos antes do prazo avisar (padrão: 60)
LEMBRETE_ANTECEDENCIA_MIN=60

# Opcional: só estes e-mails podem usar a IA (separados por vírgula)
ALLOWED_EMAILS=

# Opcional (recomendado): transcrição de áudio de alta qualidade, grátis — https://console.groq.com
GROQ_API_KEY=
