  {"id":"jimmy_fn","type":"function","z":"jimmy_tab","name":"Monta comando","func":"// Troque aqui se a entidade da Jimmy tiver outro nome no Home Assistant\nconst entidade = 'light.jimmy';\nconst alvo = { entity_id: [entidade] };\n\nif (msg.topic === 'onoff') {\n    msg.payload = { action: msg.payload ? 'light.turn_on' : 'light.turn_off', target: alvo, data: {} };\n} else if (msg.topic === 'brilho') {\n    msg.payload = { action: 'light.turn_on', target: alvo, data: { brightness_pct: Number(msg.payload) } };\n} else if (msg.topic === 'temperatura') {\n    msg.payload = { action: 'light.turn_on', target: alvo, data: { color_temp_kelvin: Number(msg.payload) } };\n} else {\n    return null;\n}\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":140,"wires":[["jimmy_ha","jimmy_dbg"]]},

